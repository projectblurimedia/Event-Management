# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL connection string (e.g. from Neon, Supabase, Railway, or local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/ms_wedding_planner?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret-min-16-chars"
JWT_EXPIRES_IN=7d

# Cloudinary (image hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (admin booking-notification emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Fast2SMS (mobile OTP for admin password reset) — optional, leave blank to disable
FAST2SMS_API_KEY=
OTP_DAILY_SMS_LIMIT=5

# Business identity (seed defaults / fallbacks)
BUSINESS_NAME="MS Wedding Planner"
BUSINESS_PHONE=8790160102
