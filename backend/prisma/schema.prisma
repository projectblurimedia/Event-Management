generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// Legacy — the app no longer has pricing, so this no longer drives any
/// behavior. Kept only so existing Category rows don't need a migration.
enum PricingMode {
  FLAT
  PER_PERSON
}

enum GalleryCategory {
  FOOD
  DECORATION
  EVENT
}

enum DietaryPreference {
  VEG
  NON_VEG
  BOTH
}

enum OtpChannel {
  EMAIL
  MOBILE
}

model AdminUser {
  id              String             @id @default(cuid())
  name            String
  email           String             @unique
  phone           String?            @unique
  passwordHash    String
  passwordResets  PasswordResetOtp[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

/// Short-lived OTP issued for the admin "forgot password" flow. The OTP
/// itself is bcrypt-hashed at rest (never stored in plaintext) and expires
/// after 10 minutes; `attempts` caps brute-force guessing.
model PasswordResetOtp {
  id        String     @id @default(cuid())
  adminId   String
  admin     AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  channel   OtpChannel
  otpHash   String
  expiresAt DateTime
  consumed  Boolean    @default(false)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([adminId])
}

/// A "bulletin" — the top-level admin-creatable section customers browse
/// and packages are built from (Food, Decoration, Welcome Drinks, DJ &
/// Sound...). Not a fixed enum, so admins can add new ones without a code
/// change. isFood gates the veg/non-veg dietary question + badge in the
/// wizard. pricingMode is unused now that the app has no pricing — kept on
/// existing rows rather than migrated away, but no longer read anywhere.
model Category {
  id            String            @id @default(cuid())
  name          String
  nameTe        String?
  slug          String            @unique
  description   String?
  descriptionTe String?
  imageUrl      String?
  pricingMode   PricingMode       @default(FLAT)
  isFood        Boolean           @default(false)
  /// Gates the dedicated admin Decorations tab and the wizard's event-type-
  /// filtered image grid, instead of the generic Item list/row layout.
  isDecoration  Boolean           @default(false)
  allowMultiple Boolean           @default(false)
  isActive      Boolean           @default(true)
  order         Int               @default(0)
  types         CategoryType[]
  packageLinks  PackageCategory[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

/// The occasion a booking/testimonial is for (Wedding, Reception, Birthday,
/// ...). Admin-manageable like Category, rather than a fixed enum, so new
/// occasions don't need a code change.
model EventType {
  id            String        @id @default(cuid())
  name          String
  nameTe        String?
  slug          String        @unique
  description   String?
  descriptionTe String?
  imageUrl      String?
  isActive      Boolean       @default(true)
  order         Int           @default(0)
  testimonials  Testimonial[]
  bookings      Booking[]
  items         Item[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

/// A sub-classification within a Category (Sweet/Hot/Flavoured Rice under
/// Food; Birthday/Marriage under Decoration). Items always belong to a type,
/// never directly to a category.
model CategoryType {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  nameTe     String?
  order      Int      @default(0)
  items      Item[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

/// The actual selectable thing a customer picks in the wizard (a dish, a
/// decoration theme, a DJ package...) — no price; the wizard is a selection
/// list, not a checkout, so the business follows up on cost separately.
model Item {
  id             String        @id @default(cuid())
  categoryTypeId String
  categoryType   CategoryType  @relation(fields: [categoryTypeId], references: [id], onDelete: Cascade)
  name           String
  nameTe         String?
  description    String?
  /// Up to 4 image URLs (Cloudinary), enforced at the API layer.
  images         String[]      @default([])
  /// Only meaningful when the parent Category has isFood = true.
  isVeg          Boolean?
  isAvailable    Boolean       @default(true)
  isFeatured     Boolean       @default(false)
  order          Int           @default(0)
  /// Restricts this item to only show up when this specific Package is
  /// selected (e.g. a "Basic Decoration" item only under Silver). Null
  /// means it shows for every package, including Custom.
  packageId      String?
  package        Package?      @relation(fields: [packageId], references: [id])
  /// For Decoration items (Category.isDecoration): which event this
  /// decoration is for (Wedding, Birthday, ...) — decoration is filtered by
  /// event type rather than package tier, unlike everything else.
  eventTypeId    String?
  eventType      EventType?    @relation(fields: [eventTypeId], references: [id])
  bookingItems   BookingItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryTypeId])
  @@index([packageId])
  @@index([eventTypeId])
}

/// A package is just a name plus an ordered list of bulletins (categories)
/// it includes — no price of its own. The booking total is always the sum
/// of whatever items the customer selects within those categories. No fixed
/// tier enum — the admin types whatever name they want ("Silver", "Gold",
/// or anything else); isFeatured drives the "Most Popular" highlight.
model Package {
  id         String            @id @default(cuid())
  name       String
  nameTe     String?
  imageUrl   String?
  isFeatured Boolean           @default(false)
  isActive   Boolean           @default(true)
  order      Int               @default(0)
  categories PackageCategory[]
  bookings   Booking[]
  items      Item[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

/// The ordered bulletin list a package walks the customer through in the
/// wizard (e.g. Silver = Food -> Decoration -> Welcome Drinks). "Custom
/// Package" has no Package row at all — the wizard shows every active
/// Category freely instead.
model PackageCategory {
  id         String   @id @default(cuid())
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  order      Int      @default(0)

  @@index([packageId])
}

model GalleryImage {
  id        String          @id @default(cuid())
  category  GalleryCategory
  imageUrl  String
  caption   String?
  captionTe String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
}

model Testimonial {
  id           String     @id @default(cuid())
  customerName String
  eventTypeId  String?
  eventType    EventType? @relation(fields: [eventTypeId], references: [id])
  rating       Int        @default(5)
  message      String
  messageTe    String?
  imageUrl     String?
  isPublished  Boolean    @default(true)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([eventTypeId])
}

model FAQ {
  id          String  @id @default(cuid())
  question    String
  questionTe  String?
  answer      String
  answerTe    String?
  order       Int     @default(0)
  isPublished Boolean @default(true)
}

model SiteSettings {
  id                   String   @id @default("singleton")
  businessName         String
  logoUrl              String?
  organiser            String
  phone                String
  whatsapp             String
  email                String
  address              String
  /// Precise coordinates from the browser Geolocation API (captured during
  /// setup or updated later) — mapEmbedUrl is only derived and shown on the
  /// public site when both are present, since a manually-typed address
  /// alone isn't reliable enough to geocode into an accurate pin.
  latitude             Float?
  longitude            Float?
  mapEmbedUrl          String?
  heroHeadline         String
  heroHeadlineTe       String?
  heroSubheadline      String
  heroSubheadlineTe    String?
  heroImageUrl         String?
  businessIntroTitle   String
  businessIntroTitleTe String?
  businessIntroText    String
  businessIntroTextTe  String?
  businessIntroImageUrl String?
  updatedAt            DateTime @updatedAt
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

enum MediaResourceType {
  IMAGE
  VIDEO
}

/// Tracks every file uploaded through the generic admin uploads endpoint,
/// regardless of which field/model ends up referencing its URL (item image,
/// hero image, intro image, ...). Exists purely to enforce a sitewide cap on
/// videos (expensive on Cloudinary's free tier) — deleting an upload removes
/// its row here too, freeing up a slot.
model MediaAsset {
  id           String            @id @default(cuid())
  publicId     String            @unique
  url          String
  resourceType MediaResourceType
  createdAt    DateTime          @default(now())

  @@index([resourceType])
}

model Booking {
  id          String @id @default(cuid())
  bookingCode String @unique

  customerName String
  phone        String
  altPhone     String?
  email        String?
  address      String

  eventDate   DateTime
  eventTime   String
  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id])
  guestCount  Int

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  dietaryPreference   DietaryPreference?
  specialRequirements String?

  status BookingStatus @default(PENDING)

  items BookingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([eventDate])
  @@index([eventTypeId])
}

/// A single selected item within a booking's list.
model BookingItem {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item    @relation(fields: [itemId], references: [id])
  quantity  Int     @default(1)

  @@index([bookingId])
}
