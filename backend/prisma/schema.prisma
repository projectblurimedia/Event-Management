generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  WEDDING
  RECEPTION
  BIRTHDAY
  HOUSEWARMING
  ENGAGEMENT
  CORPORATE
  ANNIVERSARY
  NAMING_CEREMONY
  BABY_SHOWER
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

/// How an Item's price is applied: FLAT is a single fee for the whole
/// booking (e.g. decoration theme); PER_PERSON multiplies by guest count
/// (e.g. a food dish, a welcome drink). Set once on the Category — every
/// Item under it follows automatically, no per-item choice needed.
enum PricingMode {
  FLAT
  PER_PERSON
}

enum GalleryCategory {
  FOOD
  DECORATION
  EVENT
}

enum DietaryPreference {
  VEG
  NON_VEG
  BOTH
}

enum OtpChannel {
  EMAIL
  MOBILE
}

model AdminUser {
  id              String             @id @default(cuid())
  name            String
  email           String             @unique
  phone           String?            @unique
  passwordHash    String
  passwordResets  PasswordResetOtp[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

/// Short-lived OTP issued for the admin "forgot password" flow. The OTP
/// itself is bcrypt-hashed at rest (never stored in plaintext) and expires
/// after 10 minutes; `attempts` caps brute-force guessing.
model PasswordResetOtp {
  id        String     @id @default(cuid())
  adminId   String
  admin     AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)
  channel   OtpChannel
  otpHash   String
  expiresAt DateTime
  consumed  Boolean    @default(false)
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([adminId])
}

/// A "bulletin" — the top-level admin-creatable section customers browse
/// and packages are built from (Food, Decoration, Welcome Drinks, DJ &
/// Sound...). Not a fixed enum, so admins can add new ones without a code
/// change. pricingMode decides how every Item underneath it is priced;
/// isFood gates the veg/non-veg dietary question + badge in the wizard.
model Category {
  id            String            @id @default(cuid())
  name          String
  nameTe        String?
  slug          String            @unique
  description   String?
  descriptionTe String?
  imageUrl      String?
  pricingMode   PricingMode       @default(FLAT)
  isFood        Boolean           @default(false)
  allowMultiple Boolean           @default(false)
  isActive      Boolean           @default(true)
  order         Int               @default(0)
  types         CategoryType[]
  packageLinks  PackageCategory[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

/// A sub-classification within a Category (Sweet/Hot/Flavoured Rice under
/// Food; Birthday/Marriage under Decoration). Items always belong to a type,
/// never directly to a category.
model CategoryType {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name       String
  nameTe     String?
  order      Int      @default(0)
  items      Item[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId])
}

/// The actual purchasable/selectable thing a customer picks in the wizard
/// (a dish, a decoration theme, a DJ package...). Pricing unit (flat vs per
/// person) is inherited from the parent Category, not set per item.
model Item {
  id             String        @id @default(cuid())
  categoryTypeId String
  categoryType   CategoryType  @relation(fields: [categoryTypeId], references: [id], onDelete: Cascade)
  name           String
  nameTe         String?
  description    String?
  price          Decimal       @db.Decimal(10, 2)
  /// Up to 4 image URLs (Cloudinary), enforced at the API layer.
  images         String[]      @default([])
  /// Only meaningful when the parent Category has isFood = true.
  isVeg          Boolean?
  isAvailable    Boolean       @default(true)
  isFeatured     Boolean       @default(false)
  order          Int           @default(0)
  bookingItems   BookingItem[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([categoryTypeId])
}

/// A package is just a name plus an ordered list of bulletins (categories)
/// it includes — no price of its own. The booking total is always the sum
/// of whatever items the customer selects within those categories. No fixed
/// tier enum — the admin types whatever name they want ("Silver", "Gold",
/// or anything else); isFeatured drives the "Most Popular" highlight.
model Package {
  id         String            @id @default(cuid())
  name       String
  nameTe     String?
  imageUrl   String?
  isFeatured Boolean           @default(false)
  isActive   Boolean           @default(true)
  order      Int               @default(0)
  categories PackageCategory[]
  bookings   Booking[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

/// The ordered bulletin list a package walks the customer through in the
/// wizard (e.g. Silver = Food -> Decoration -> Welcome Drinks). "Custom
/// Package" has no Package row at all — the wizard shows every active
/// Category freely instead.
model PackageCategory {
  id         String   @id @default(cuid())
  packageId  String
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  order      Int      @default(0)

  @@index([packageId])
}

model GalleryImage {
  id        String          @id @default(cuid())
  category  GalleryCategory
  imageUrl  String
  caption   String?
  captionTe String?
  order     Int             @default(0)
  createdAt DateTime        @default(now())
}

model Testimonial {
  id           String     @id @default(cuid())
  customerName String
  eventType    EventType?
  rating       Int        @default(5)
  message      String
  messageTe    String?
  imageUrl     String?
  isPublished  Boolean    @default(true)
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
}

model FAQ {
  id          String  @id @default(cuid())
  question    String
  questionTe  String?
  answer      String
  answerTe    String?
  order       Int     @default(0)
  isPublished Boolean @default(true)
}

model SiteSettings {
  id                   String   @id @default("singleton")
  businessName         String
  logoUrl              String?
  organiser            String
  phone                String
  whatsapp             String
  email                String
  address              String
  /// Precise coordinates from the browser Geolocation API (captured during
  /// setup or updated later) — mapEmbedUrl is only derived and shown on the
  /// public site when both are present, since a manually-typed address
  /// alone isn't reliable enough to geocode into an accurate pin.
  latitude             Float?
  longitude            Float?
  mapEmbedUrl          String?
  heroHeadline         String
  heroHeadlineTe       String?
  heroSubheadline      String
  heroSubheadlineTe    String?
  heroImageUrl         String?
  businessIntroTitle   String
  businessIntroTitleTe String?
  businessIntroText    String
  businessIntroTextTe  String?
  updatedAt            DateTime @updatedAt
}

model ContactEnquiry {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Booking {
  id          String @id @default(cuid())
  bookingCode String @unique

  customerName String
  phone        String
  altPhone     String?
  email        String?
  address      String

  eventDate  DateTime
  eventTime  String
  eventType  EventType
  guestCount Int

  packageId String?
  package   Package? @relation(fields: [packageId], references: [id])

  dietaryPreference   DietaryPreference?
  specialRequirements String?

  /// Sum of selected items priced PER_PERSON (already multiplied by guestCount).
  perPersonCost Decimal @db.Decimal(10, 2) @default(0)
  /// Sum of selected items priced FLAT.
  flatCost      Decimal @db.Decimal(10, 2) @default(0)
  grandTotal    Decimal @db.Decimal(10, 2) @default(0)

  status BookingStatus @default(PENDING)

  items BookingItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([status])
  @@index([eventDate])
}

/// priceAtBooking + quantity snapshot so historical quotations stay
/// accurate even if catalogue prices change later. For PER_PERSON items,
/// quantity is the guest count at time of booking (mirrors the old
/// per-plate model); for FLAT items it's normally 1.
model BookingItem {
  id             String  @id @default(cuid())
  bookingId      String
  booking        Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  itemId         String
  item           Item    @relation(fields: [itemId], references: [id])
  quantity       Int     @default(1)
  priceAtBooking Decimal @db.Decimal(10, 2)

  @@index([bookingId])
}
