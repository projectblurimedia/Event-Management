{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|WhatsApp|Twitterbot|LinkedInBot|TelegramBot|Slackbot|Discordbot|SkypeUriPreview|Pinterest|redditbot|Iframely|Embedly).*"
        }
      ],
      "destination": "/api/og"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
